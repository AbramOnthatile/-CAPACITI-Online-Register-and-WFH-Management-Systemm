# Copy this file to .env in this folder and fill in the values.
# .env is git-ignored. Never put real values in this example file.
# Use plain KEY=value lines with no quotes. Escape a backslash as \\.

# Supabase > Connect > Session pooler. Keep the jdbc:postgresql:// prefix.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<database-password>

# Base64 of at least 32 random bytes. Generate once and keep it the same.
JWT_SECRET=<base64-secret>
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=http://localhost:3000

# First run only: creates the demo campus and users, then set SEED_ENABLED=false.
SEED_ENABLED=false
SEED_PASSWORD=<demo-password-min-8-chars>

# Optional integrations; leave empty to switch them off.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
TEAMS_WEBHOOK_URL=
APP_TRUSTED_PROXIES=
